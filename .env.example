# Application
APP_ENV=production
SITE_URL=https://tudominio.com
SITE_NAME=Tu Sistema de Tickets
ADMIN_EMAIL=admin@tudominio.com

# Cloudflare D1 Worker
D1_API_URL=https://tickets-api.crtv-technologies.workers.dev
D1_API_TOKEN=replace_with_worker_secret
PAYMENT_FULFILL_TOKEN=replace_with_private_fulfillment_secret

# Email / SMTP
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USERNAME=tu_usuario@tudominio.com
SMTP_PASSWORD=tu_contraseña_smtp
SMTP_FROM_EMAIL=no-reply@tudominio.com
SMTP_FROM_NAME=Tu Empresa

# Optional inventory cache (Upstash Redis)
REDIS_REST_URL=https://TU-INSTANCIA.upstash.io
REDIS_REST_TOKEN=TU_TOKEN_DE_UPSTASH

# Stripe platform account
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
